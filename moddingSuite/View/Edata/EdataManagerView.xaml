<Window
    x:Class="moddingSuite.View.Edata.EdataManagerView"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Edata="clr-namespace:moddingSuite.View.Edata"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:edata="clr-namespace:moddingSuite.ViewModel.Edata"
    xmlns:extension="clr-namespace:moddingSuite.View.Extension"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:moddingSuite.View"
    Title="Wargame Modding Suite"
    Width="1367.591"
    Height="729.885"
    Icon="{StaticResource PackageFileIcon}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <extension:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>
    <Grid>
        <UniformGrid
            Margin="0,0,0,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="1000"
            d:IsHidden="True"
            Background="White"
            Visibility="{Binding Path=IsUIBusy, Converter={StaticResource BoolToVisibilityCollapsedConverter}}">
            <view:SpinningWheel
                x:Name="wheel"
                Direction="CW"
                DotCount="21"
                DotRadius="7"
                IsSpinning="True"
                Radius="36"
                Speed="1.25"
                SymmetricalArrange="True" />
        </UniformGrid>

        <Grid Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Menu
                Grid.Row="0"
                Grid.ColumnSpan="2"
                IsMainMenu="True">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding Path=OpenFileCommand}" Header="_Open" />
                    <MenuItem Command="{Binding Path=CloseFileCommand}" Header="_Close" />
                </MenuItem>
                <MenuItem Header="_Settings">
                    <MenuItem Command="{Binding Path=ChangeExportPathCommand}" Header="Change _export path" />
                    <MenuItem Command="{Binding Path=ChangeWargamePathCommand}" Header="Change _Wargame path" />
                    <MenuItem Command="{Binding Path=ChangePythonPathCommand}" Header="Change _Python path" />
                    <MenuItem Command="{Binding Path=ChangeQuickBmsPathCommand}" Header="Change _QuickBMS exe" />
                    <MenuItem Command="{Binding Path=ChangeQuickBmsScriptPathCommand}" Header="Change QuickBMS _script" />
                </MenuItem>
                <MenuItem Header="_Window">
                    <MenuItem
                        Command="{Binding ToggleAnchorableVisibilityCommand}"
                        CommandParameter="workspace"
                        Header="Toggle _Workspace panel" />
                    <MenuItem
                        Command="{Binding ToggleAnchorableVisibilityCommand}"
                        CommandParameter="gamespace"
                        Header="Toggle _Gamespace panel" />
                    <MenuItem
                        Command="{Binding ToggleAnchorableVisibilityCommand}"
                        CommandParameter="zzVirtual"
                        Header="Toggle _ZZ Virtual panel" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ResetPaneLayoutCommand}"
                        Header="_Reset panel layout" />
                    <Separator />
                    <MenuItem Header="Open _documents" ItemsSource="{Binding OpenFiles}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding HeaderText}" />
                                <Setter Property="ToolTip" Value="{Binding LoadedFile}" />
                                <Setter Property="Command" Value="{Binding Data.FocusDocumentCommand, Source={StaticResource Proxy}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <ToolBar Grid.Row="1" Style="{StaticResource Vs2010StyleToolBar}">
                <Menu>
                    <MenuItem ToolTip="Raw data">
                        <MenuItem.Header>
                            <Image Source="{StaticResource ExtractRawIcon}" />
                        </MenuItem.Header>
                        <MenuItem Command="{Binding ExportRawCommand}" Header="Export">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ExportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ReplaceRawCommand}" Header="Replace">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ImportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
                <Button
                    Command="{Binding Path=ExportNdfCommand}"
                    Style="{DynamicResource ButtonStyle1}"
                    ToolTip="Export Uncompressed NDF content">
                    <Image Width="16 " Source="{StaticResource ExtractZipedPartIcon}" />
                </Button>

                <Menu>
                    <MenuItem ToolTip="Textures">
                        <MenuItem.Header>
                            <Image Source="{StaticResource TextureIcon}" />
                        </MenuItem.Header>
                        <MenuItem Command="{Binding ExportTextureCommand}" Header="Export">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ExportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ReplaceTextureCommand}" Header="Replace">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ImportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Menu>
                    <MenuItem ToolTip="Sounds">
                        <MenuItem.Header>
                            <Image Source="{StaticResource SoundIcon}" />
                        </MenuItem.Header>
                        <MenuItem Command="{Binding ExportSoundCommand}" Header="Export">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ExportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ReplaceSoundCommand}" Header="Replace">
                            <MenuItem.Icon>
                                <Image Source="{StaticResource ImportIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Separator />

                <Button
                    Command="{Binding EditNdfbinCommand}"
                    Style="{DynamicResource ButtonStyle1}"
                    ToolTip="Edit ndf file">
                    <Image Source="{StaticResource OpenDetailsIcon}" />
                </Button>
                <Button
                    Command="{Binding EditMeshCommand}"
                    Style="{DynamicResource ButtonStyle1}"
                    ToolTip="Edit mesh file">
                    <Image Source="{StaticResource MeshFileIcon}" />
                </Button>
                <Button
                    Command="{Binding EditTradFileCommand}"
                    Style="{DynamicResource ButtonStyle1}"
                    ToolTip="Edit dictionary">
                    <Image Source="{StaticResource OpenDictionayIcon}" />
                </Button>
                <Separator />
                <Button
                    Command="{Binding AboutUsCommand}"
                    Style="{DynamicResource ButtonStyle1}"
                    ToolTip="About">
                    <Image Source="{StaticResource AboutIcon}" />
                </Button>

            </ToolBar>

            <!-- Main work area: AvalonDock — documents in centre, anchorable panels on right (Photoshop-style drag/dock). -->
            <avalonDock:DockingManager
                x:Name="DockManager"
                Grid.Row="2"
                DocumentsSource="{Binding OpenFiles}">

                <!-- DocumentHeaderTemplate sets the tab title that AvalonDock shows
                     for documents in DocumentsSource. DataContext here is the
                     LayoutContent (LayoutDocument); its Content is the VM. -->
                <avalonDock:DockingManager.DocumentHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Content.HeaderText}" ToolTip="{Binding Content.LoadedFile}" />
                    </DataTemplate>
                </avalonDock:DockingManager.DocumentHeaderTemplate>

                <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                    <edata:PaneStyleSelector>
                        <edata:PaneStyleSelector.DocumentStyle>
                            <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                                <!-- LayoutItem.Model is the LayoutContent (LayoutDocument); its Content is the bound view model -->
                                <Setter Property="Title" Value="{Binding Model.Content.HeaderText}" />
                                <Setter Property="ToolTip" Value="{Binding Model.Content.LoadedFile}" />
                                <Setter Property="CloseCommand" Value="{Binding Model.Content.CloseCommand}" />
                                <Setter Property="CanClose" Value="True" />
                            </Style>
                        </edata:PaneStyleSelector.DocumentStyle>
                        <edata:PaneStyleSelector.AnchorableStyle>
                            <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                                <Setter Property="Title" Value="{Binding Model.Content.Title}" />
                                <Setter Property="CanClose" Value="False" />
                                <Setter Property="CanHide" Value="True" />
                            </Style>
                        </edata:PaneStyleSelector.AnchorableStyle>
                    </edata:PaneStyleSelector>
                </avalonDock:DockingManager.LayoutItemContainerStyleSelector>

                <!-- One template for ALL items; the inner ContentPresenter resolves
                     the per-type DataTemplate from Resources below. -->
                <avalonDock:DockingManager.LayoutItemTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" />
                    </DataTemplate>
                </avalonDock:DockingManager.LayoutItemTemplate>

                <avalonDock:DockingManager.Resources>
                    <!-- Document content (.dat file viewer) -->
                    <DataTemplate DataType="{x:Type edata:EdataFileViewModel}">
                        <Edata:EdataFileView />
                    </DataTemplate>

                    <!-- Workspace anchorable: local filesystem tree (Owner.Workspace.Root) -->
                    <DataTemplate DataType="{x:Type edata:WorkspacePaneViewModel}">
                        <Grid Background="LightCyan">
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="10" Foreground="Red"
                                       Text="{Binding Owner.Workspace.Root.Count, StringFormat='Owner.Workspace.Root.Count = {0}'}" />
                            <TreeView Margin="0,20,0,0" extension:TreeViewExtension.SelectItemOnRightClick="true" ItemsSource="{Binding Owner.Workspace.Root}">
                            <TreeView.Resources>
                                <ContextMenu x:Key="workspaceContextMenu">
                                    <MenuItem
                                        Command="{Binding Data.ReplaceRawFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Info.FullName}"
                                        Header="Import raw file">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ImportIcon}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding Data.ReplaceSoundFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Info.FullName}"
                                        Header="Import as Ess sound file">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ImportIcon}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding Data.ReplaceTextureFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Info.FullName}"
                                        Header="Import as tgv texture file">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ImportIcon}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding Data.AddNewFileCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding}"
                                        Header="Open as Edata Container">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource OpenEdataPackageIcon}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                                <HierarchicalDataTemplate DataType="{x:Type edata:FileViewModel}">
                                    <Grid ContextMenu="{StaticResource workspaceContextMenu}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Height="16" Source="{StaticResource GenericFileIcon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,2,2,2"
                                            Text="{Binding Name}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </DataTemplate>

                    <!-- Gamespace anchorable: WARNO\Data\PC tree -->
                    <DataTemplate DataType="{x:Type edata:GamespacePaneViewModel}">
                        <TreeView extension:TreeViewExtension.SelectItemOnRightClick="true" ItemsSource="{Binding Owner.Gamespace.DisplayRoot}">
                            <TreeView.Resources>
                                <DataTemplate DataType="{x:Type edata:FileViewModel}">
                                    <Grid>
                                        <Grid.InputBindings>
                                            <MouseBinding
                                                Command="{Binding Path=Data.AddNewFileCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                MouseAction="LeftDoubleClick" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Height="16" Source="{StaticResource GenericFileIcon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,2,2,2"
                                            Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DataTemplate>

                    <!-- ZZ Virtual anchorable: search + Build/Export/Extract + Unified ZZ tree -->
                    <DataTemplate DataType="{x:Type edata:ZzVirtualPaneViewModel}">
                        <DockPanel LastChildFill="True">
                            <StackPanel Margin="4,2,4,4" DockPanel.Dock="Top">
                                <CheckBox
                                    Content="Show only ZZ_#.dat files"
                                    IsChecked="{Binding Owner.Gamespace.ShowOnlyZzDatFiles}" />
                                <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                    <Button
                                        Width="70"
                                        Margin="6,0,0,0"
                                        Command="{Binding Owner.SearchInZzDatCommand}"
                                        Content="Search"
                                        DockPanel.Dock="Right" />
                                    <TextBox Text="{Binding Owner.ZzDatSearchQuery, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Owner.SearchInZzDatCommand}" />
                                        </TextBox.InputBindings>
                                        <TextBox.ToolTip>
                                            Search file/path name inside all ZZ_*.dat packages
                                        </TextBox.ToolTip>
                                    </TextBox>
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button
                                        Width="145"
                                        Margin="0,0,6,0"
                                        Command="{Binding Owner.BuildUnifiedZzVirtualViewCommand}"
                                        Content="Build Virtual ZZ View" />
                                    <Button
                                        Width="120"
                                        Margin="0,0,6,0"
                                        Command="{Binding Owner.ExportSelectedFromUnifiedZzCommand}"
                                        Content="Export Selected" />
                                    <Button
                                        Width="160"
                                        Command="{Binding Owner.ExtractUnifiedZzToFolderCommand}"
                                        Content="Extract Output to Folder" />
                                </WrapPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="#FF7A5A00"
                                    Text="Note: Extraction may take 1-2 hours and requires 40+ GB of free disk space."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="{Binding Owner.UnifiedZzStatusText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox
                                Height="120"
                                Margin="4,0,4,4"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding Owner.ZzDatSearchResults}" />
                            <TreeView
                                Margin="4,0,4,4"
                                extension:TreeViewExtension.SelectItemOnRightClick="true"
                                extension:TreeViewMultiSelectBehavior.EnableMultiSelect="True"
                                extension:TreeViewMultiSelectBehavior.SelectedItems="{Binding Owner.SelectedUnifiedZzNodes}"
                                ItemsSource="{Binding Owner.UnifiedZzRootNodes}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <ContextMenu x:Key="unifiedNodeContextMenu">
                                        <MenuItem
                                            Command="{Binding Data.ConvertVirtualEssToWavCommand, Source={StaticResource Proxy}}"
                                            CommandParameter="{Binding}"
                                            Header="Convert to WAV...">
                                            <MenuItem.Icon>
                                                <Image Source="{StaticResource ExportIcon}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                    <HierarchicalDataTemplate DataType="{x:Type edata:VirtualNodeViewModel}" ItemsSource="{Binding Children}">
                                        <Border
                                            x:Name="UnifiedNodeSelectionBorder"
                                            Margin="1,0,1,0"
                                            Padding="1"
                                            Background="Transparent"
                                            ContextMenu="{StaticResource unifiedNodeContextMenu}"
                                            CornerRadius="2">
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding Path=Data.OpenUnifiedZzNodeCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding}"
                                                        MouseAction="LeftDoubleClick" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    x:Name="UnifiedNodeIcon"
                                                    Height="16"
                                                    Source="{StaticResource GenericFileIcon}" />
                                                <TextBlock
                                                    x:Name="UnifiedNodeText"
                                                    Grid.Column="1"
                                                    Margin="5,1,2,1"
                                                    Text="{Binding DisplayName}" />
                                            </Grid>
                                        </Border>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNdfbin}" Value="True">
                                                <Setter TargetName="UnifiedNodeIcon" Property="Source" Value="{StaticResource ScriptIcon}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter TargetName="UnifiedNodeIcon" Property="Source" Value="{StaticResource VsFolderIcon}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsFolder}" Value="True" />
                                                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="UnifiedNodeIcon" Property="Source" Value="{StaticResource VsFolderIconOpen}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                <Setter TargetName="UnifiedNodeSelectionBorder" Property="Background" Value="#FF2D7D9A" />
                                                <Setter TargetName="UnifiedNodeText" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </DataTemplate>
                </avalonDock:DockingManager.Resources>

                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>
                        <avalonDock:LayoutAnchorablePaneGroup
                            DockMinWidth="280"
                            DockWidth="380"
                            Orientation="Vertical">
                            <avalonDock:LayoutAnchorablePane DockHeight="*">
                                <avalonDock:LayoutAnchorable Title="Workspace" ContentId="workspace" CanClose="False" CanDockAsTabbedDocument="False">
                                    <Grid DataContext="{Binding DataContext, ElementName=RootWindow}">
                                        <TreeView extension:TreeViewExtension.SelectItemOnRightClick="true" ItemsSource="{Binding Workspace.Root}">
                                            <TreeView.Resources>
                                                <ContextMenu x:Key="workspaceContextMenuStatic">
                                                    <MenuItem
                                                        Command="{Binding Data.ReplaceRawFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding Info.FullName}"
                                                        Header="Import raw file">
                                                        <MenuItem.Icon>
                                                            <Image Source="{StaticResource ImportIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Command="{Binding Data.ReplaceSoundFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding Info.FullName}"
                                                        Header="Import as Ess sound file">
                                                        <MenuItem.Icon>
                                                            <Image Source="{StaticResource ImportIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Command="{Binding Data.ReplaceTextureFromWorkspaceCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding Info.FullName}"
                                                        Header="Import as tgv texture file">
                                                        <MenuItem.Icon>
                                                            <Image Source="{StaticResource ImportIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem
                                                        Command="{Binding Data.AddNewFileCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding}"
                                                        Header="Open as Edata Container">
                                                        <MenuItem.Icon>
                                                            <Image Source="{StaticResource OpenEdataPackageIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                                <HierarchicalDataTemplate DataType="{x:Type edata:FileViewModel}">
                                                    <Grid ContextMenu="{StaticResource workspaceContextMenuStatic}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Height="16" Source="{StaticResource GenericFileIcon}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,2,2,2"
                                                            Text="{Binding Name}" />
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                    </Grid>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorablePane DockHeight="*">
                                <avalonDock:LayoutAnchorable Title="Gamespace" ContentId="gamespace" CanClose="False" CanDockAsTabbedDocument="False">
                                    <Grid DataContext="{Binding DataContext, ElementName=RootWindow}">
                                        <TreeView extension:TreeViewExtension.SelectItemOnRightClick="true" ItemsSource="{Binding Gamespace.DisplayRoot}">
                                            <TreeView.Resources>
                                                <DataTemplate DataType="{x:Type edata:FileViewModel}">
                                                    <Grid>
                                                        <Grid.InputBindings>
                                                            <MouseBinding
                                                                Command="{Binding Path=Data.AddNewFileCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                MouseAction="LeftDoubleClick" />
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Height="16" Source="{StaticResource GenericFileIcon}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,2,2,2"
                                                            Text="{Binding Name}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                    </Grid>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorablePane DockHeight="2*">
                                <avalonDock:LayoutAnchorable Title="ZZ Virtual" ContentId="zzVirtual" CanClose="False" CanDockAsTabbedDocument="False">
                                    <DockPanel DataContext="{Binding DataContext, ElementName=RootWindow}" LastChildFill="True">
                                        <DockPanel.Resources>
                                            <!-- Shared by the tree, tile and list panels so right-click menus
                                                 work from any view mode. -->
                                            <ContextMenu x:Key="unifiedNodeContextMenuStatic">
                                                <MenuItem
                                                    Command="{Binding Data.ConvertVirtualEssToWavCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Header="Convert to WAV...">
                                                    <MenuItem.Icon>
                                                        <Image Source="{StaticResource ExportIcon}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{Binding Data.ExportTgvAsPngCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Header="Export TGV as PNG...">
                                                    <MenuItem.Icon>
                                                        <Image Source="{StaticResource TextureIcon}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{Binding Data.ExtractAtlasTexturesCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Header="Extract atlas textures...">
                                                    <MenuItem.Icon>
                                                        <Image Source="{StaticResource TextureIcon}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DockPanel.Resources>
                                        <StackPanel Margin="4,2,4,4" DockPanel.Dock="Top">
                                            <CheckBox
                                                Content="Show only ZZ_#.dat files"
                                                IsChecked="{Binding Gamespace.ShowOnlyZzDatFiles}" />
                                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                                <Button
                                                    Width="70"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding SearchInZzDatCommand}"
                                                    Content="Search"
                                                    DockPanel.Dock="Right" />
                                                <TextBox Text="{Binding ZzDatSearchQuery, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding SearchInZzDatCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </DockPanel>
                                            <WrapPanel Margin="0,4,0,0">
                                                <Button
                                                    Width="180"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding BuildUnifiedZzVirtualViewCommand}"
                                                    Content="Scan ZZ Archives"
                                                    ToolTip="Index every ZZ_#.dat in the WARNO Output folder and build a unified browsable tree." />
                                                <Button
                                                    Width="200"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding ExportSelectedFromUnifiedZzCommand}"
                                                    Content="Save Selected to Disk..."
                                                    ToolTip="Save the files currently highlighted in the tree to a folder of your choice." />
                                                <Button
                                                    Width="240"
                                                    Command="{Binding ExtractUnifiedZzToFolderCommand}"
                                                    Content="Unpack Whole Game to Disk..."
                                                    ToolTip="Extract every file from every ZZ_#.dat to a folder of your choice (1-2 hours, 40+ GB)." />
                                            </WrapPanel>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="#FF7A5A00"
                                                Text="Note: Extraction may take 1-2 hours and requires 40+ GB of free disk space."
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Text="{Binding UnifiedZzStatusText}"
                                                TextWrapping="Wrap" />
                                            <!-- View-mode toggle, kept here (not inside the right pane) so the user can
                                                 always switch back to Tiles/List after picking Tree, which hides the pane. -->
                                            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Text="View:" />
                                                    <ToggleButton
                                                        Width="50"
                                                        Margin="0,0,2,0"
                                                        Command="{Binding SetZzTreeModeCommand}"
                                                        Content="Tree"
                                                        IsChecked="{Binding IsZzTreeMode, Mode=OneWay}"
                                                        ToolTip="Hide right pane, show full tree only" />
                                                    <ToggleButton
                                                        Width="50"
                                                        Margin="0,0,2,0"
                                                        Command="{Binding SetZzTilesModeCommand}"
                                                        Content="Tiles"
                                                        IsChecked="{Binding IsZzTilesMode, Mode=OneWay}"
                                                        ToolTip="Show folder contents as tiles with TGV previews" />
                                                    <ToggleButton
                                                        Width="50"
                                                        Command="{Binding SetZzListModeCommand}"
                                                        Content="List"
                                                        IsChecked="{Binding IsZzListMode, Mode=OneWay}"
                                                        ToolTip="Show folder contents as compact list" />
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontStyle="Italic"
                                                    Foreground="#FF505050"
                                                    Text="{Binding CurrentZzFolderPath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding IsZzContentPaneVisible, Converter={StaticResource BoolToVisibilityCollapsedConverter}}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- Search results: collapsed until a search returns rows; resizable via splitter -->
                                            <ListBox
                                                Grid.Row="0"
                                                MinHeight="60"
                                                MaxHeight="240"
                                                Margin="4,0,4,4"
                                                ItemsSource="{Binding ZzDatSearchResults}">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <Trigger Property="HasItems" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                            </ListBox>
                                            <GridSplitter
                                                Grid.Row="1"
                                                Height="4"
                                                Margin="4,0,4,2"
                                                HorizontalAlignment="Stretch"
                                                Background="#FFB0B0B0"
                                                ResizeBehavior="PreviousAndNext"
                                                ResizeDirection="Rows">
                                                <GridSplitter.Style>
                                                    <Style TargetType="GridSplitter">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ZzDatSearchResults.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </GridSplitter.Style>
                                            </GridSplitter>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="2*" MinWidth="0" />
                                                </Grid.ColumnDefinitions>
                                                <TreeView
                                                Grid.Column="0"
                                                Margin="4,0,4,4"
                                                extension:TreeViewExtension.SelectItemOnRightClick="true"
                                                extension:TreeViewMultiSelectBehavior.EnableMultiSelect="True"
                                                extension:TreeViewMultiSelectBehavior.SelectedItems="{Binding SelectedUnifiedZzNodes}"
                                                ItemsSource="{Binding UnifiedZzRootNodes}"
                                                SelectedItemChanged="UnifiedZzTree_SelectedItemChanged">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="{x:Type TreeViewItem}">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type edata:VirtualNodeViewModel}" ItemsSource="{Binding Children}">
                                                    <Border
                                                        x:Name="UnifiedNodeSelectionBorder2"
                                                        Margin="1,0,1,0"
                                                        Padding="1"
                                                        Background="Transparent"
                                                        ContextMenu="{StaticResource unifiedNodeContextMenuStatic}"
                                                        CornerRadius="2">
                                                        <Grid>
                                                            <Grid.InputBindings>
                                                                <MouseBinding
                                                                    Command="{Binding Path=Data.OpenUnifiedZzNodeCommand, Source={StaticResource Proxy}}"
                                                                    CommandParameter="{Binding}"
                                                                    MouseAction="LeftDoubleClick" />
                                                            </Grid.InputBindings>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                x:Name="UnifiedNodeIcon2"
                                                                Height="16"
                                                                Source="{StaticResource GenericFileIcon}" />
                                                            <TextBlock
                                                                x:Name="UnifiedNodeText2"
                                                                Grid.Column="1"
                                                                Margin="5,1,2,1"
                                                                Text="{Binding DisplayName}" />
                                                        </Grid>
                                                    </Border>
                                                    <HierarchicalDataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsTexture}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource TextureIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource SoundIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMesh}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource MeshFileIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPython}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource PythonIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPackage}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource PackageFileIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNdfbin}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource ScriptIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource VsFolderIcon}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFolder}" Value="True" />
                                                                <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="UnifiedNodeIcon2" Property="Source" Value="{StaticResource VsFolderIconOpen}" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                            <Setter TargetName="UnifiedNodeSelectionBorder2" Property="Background" Value="#FF2D7D9A" />
                                                            <Setter TargetName="UnifiedNodeText2" Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </HierarchicalDataTemplate.Triggers>
                                                </HierarchicalDataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                                <GridSplitter
                                                    Grid.Column="1"
                                                    Width="4"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="#FFB0B0B0"
                                                    ResizeBehavior="PreviousAndNext"
                                                    ResizeDirection="Columns"
                                                    Visibility="{Binding IsZzContentPaneVisible, Converter={StaticResource BoolToVisibilityCollapsedConverter}}" />
                                                <DockPanel
                                                    Grid.Column="2"
                                                    Margin="0,0,4,4"
                                                    LastChildFill="True"
                                                    Visibility="{Binding IsZzContentPaneVisible, Converter={StaticResource BoolToVisibilityCollapsedConverter}}">
                                                    <!-- Tiles view: ListBox so each tile gets IsSelected (blue highlight) + keyboard nav. -->
                                                    <ListBox
                                                        BorderThickness="0"
                                                        ItemsSource="{Binding CurrentZzFolderChildren}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                        SelectionMode="Extended"
                                                        Visibility="{Binding IsZzTilesMode, Converter={StaticResource BoolToVisibilityCollapsedConverter}}">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <!-- Strip default ListBoxItem chrome; we paint our own border via the template. -->
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="ContextMenu" Value="{StaticResource unifiedNodeContextMenuStatic}" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <ContentPresenter />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type edata:VirtualNodeViewModel}">
                                                                <Border
                                                                    Width="108"
                                                                    Height="124"
                                                                    Margin="4"
                                                                    Padding="4"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding
                                                                            Command="{Binding Path=Data.OpenUnifiedZzNodeCommand, Source={StaticResource Proxy}}"
                                                                            CommandParameter="{Binding}"
                                                                            MouseAction="LeftDoubleClick" />
                                                                    </Border.InputBindings>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                                    <Setter Property="Background" Value="#22409EFF" />
                                                                                    <Setter Property="BorderBrush" Value="#FF7AB6FF" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="#552D7D9A" />
                                                                                    <Setter Property="BorderBrush" Value="#FF2D7D9A" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="96" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid Grid.Row="0" Background="#FFEAEAEA">
                                                                            <!-- Icon (default GenericFileIcon, overridden by data triggers below). -->
                                                                            <Image
                                                                                Width="48"
                                                                                Height="48"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Setter Property="Source" Value="{StaticResource GenericFileIcon}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsTexture}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource TextureIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource SoundIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsMesh}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource MeshFileIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsPython}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource PythonIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsPackage}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource PackageFileIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsNdfbin}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource ScriptIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                                                <Setter Property="Source" Value="{StaticResource VsFolderIcon}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                            <!-- Thumbnail (covers icon once loaded). -->
                                                                            <Image
                                                                                Margin="2"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                                                Source="{Binding Thumbnail}"
                                                                                Stretch="Uniform" />
                                                                        </Grid>
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Margin="2,4,2,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            FontSize="11"
                                                                            Text="{Binding Name}"
                                                                            TextAlignment="Center"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="Wrap"
                                                                            ToolTip="{Binding RelativePath}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <!-- List view -->
                                                    <ListView
                                                        ItemsSource="{Binding CurrentZzFolderChildren}"
                                                        Visibility="{Binding IsZzListMode, Converter={StaticResource BoolToVisibilityCollapsedConverter}}">
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="ContextMenu" Value="{StaticResource unifiedNodeContextMenuStatic}" />
                                                                <EventSetter Event="MouseDoubleClick" Handler="ZzListItem_MouseDoubleClick" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridViewColumn Width="280" Header="Name">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate DataType="{x:Type edata:VirtualNodeViewModel}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Image Width="16" Height="16">
                                                                                    <Image.Style>
                                                                                        <Style TargetType="Image">
                                                                                            <Setter Property="Source" Value="{StaticResource GenericFileIcon}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsTexture}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource TextureIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource SoundIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsMesh}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource MeshFileIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsPython}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource PythonIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsPackage}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource PackageFileIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsNdfbin}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource ScriptIcon}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                                                    <Setter Property="Source" Value="{StaticResource VsFolderIcon}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Image.Style>
                                                                                </Image>
                                                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Width="80" Header="Kind">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate DataType="{x:Type edata:VirtualNodeViewModel}">
                                                                            <TextBlock>
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="File" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                                                <Setter Property="Text" Value="Folder" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding FileCount}" Header="Items" />
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>


            <Grid
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White" />

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="4,2,4,2"
                    Padding="4"
                    BorderBrush="#FFB0B0B0"
                    BorderThickness="1"
                    Visibility="{Binding IsExtractInProgress, Converter={StaticResource BoolToVisibilityCollapsedConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Text="{Binding ExtractProgressText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Center" />
                        <ProgressBar
                            Grid.Column="0"
                            Height="16"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ExtractPercent}" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <TabItem.Header>
                            <DockPanel>
                                <ToggleButton
                                    x:Name="OutputPushPin"
                                    Height="15"
                                    Margin="15,0,0,0"
                                    Padding="0"
                                    DockPanel.Dock="Right"
                                    IsChecked="True"
                                    Style="{StaticResource ToggleButtonStyle1}">
                                    <Image Source="{StaticResource PushPinIcon}" />
                                </ToggleButton>
                                <TextBlock Text="Output" />
                            </DockPanel>
                        </TabItem.Header>
                        <TextBox
                            IsReadOnly="True"
                            Text="{Binding Path=StatusText}"
                            TextWrapping="WrapWithOverflow"
                            Visibility="{Binding IsChecked, ElementName=OutputPushPin, Converter={StaticResource BoolToVisibilityCollapsedConverter}}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
